# ===== backend 환경변수 =====
# 로컬 개발 시 이 파일을 .env 로 복사해 값을 채운다.
# 프로덕션(Render 등)에서는 대시보드의 환경변수로 등록한다.

# 서버 포트 (Render는 자동 주입하므로 프로덕션에선 비워둠)
PORT=8000
# development | production
NODE_ENV=development

# MongoDB 연결 문자열
#  - 로컬:  mongodb://localhost:27017/kanji
#  - Atlas: mongodb+srv://<user>:<pass>@<cluster>/kanji?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/kanji

# CORS 허용 오리진 (콤마 구분). 프론트 배포 도메인을 반드시 등록.
#  예) https://kan-ji.vercel.app,http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200

# 세션/토큰 비밀키 (충분히 긴 랜덤 문자열)
SESSION_SECRET=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=1d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 프론트 도메인 기준 콜백 URL (Google Cloud 콘솔에 동일하게 등록)
#  예) https://kan-ji.vercel.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4200/auth/google/callback

# Kakao OAuth
KAKAO_REST_API_KEY=your-kakao-rest-api-key
