# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/kanji-learning

# Session Secret
SESSION_SECRET=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:4200

# Checkpoint Configuration
# Auto-save interval (in words)
# Development default: 1 (every word)
# Production default: 5 (every 5 words)
CHECKPOINT_SAVE_INTERVAL=1

# Maximum checkpoints to keep per user/session type
CHECKPOINT_MAX_PER_USER=10

# Checkpoint expiration in days
CHECKPOINT_EXPIRATION_DAYS=30

# Enable verbose checkpoint logging (true/false)
# Automatically enabled in development mode
CHECKPOINT_VERBOSE_LOGGING=true
