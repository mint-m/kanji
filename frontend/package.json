{
  "name": "kanji-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-oauth/google": "0.12.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.36",
    "@types/react": "^18.2.12",
    "@types/react-dom": "^18.2.5",
    "@types/react-redux": "^7.1.25",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/dynamic": "^2.1.5",
    "axios": "^1.4.0",
    "http-proxy-middleware": "2.0.6",
    "lodash": "^4.17.21",
    "rc-slider": "10.2.1",
    "rc-tooltip": "^6.0.1",
    "react": "^18.2.0",
    "react-awesome-slider": "^4.1.0",
    "react-dom": "^18.2.0",
    "react-page-scroller": "^3.0.1",
    "react-redux": "^8.1.1",
    "react-router-dom": "^6.13.0",
    "redux": "^4.2.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-restricted-imports": [
        "error",
        {
          "paths": [
            {
              "name": "axios",
              "message": "❌ Direct axios import is not allowed. Use 'services/apiClient' for authenticated APIs."
            }
          ]
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "**/services/apiClient.ts",
          "**/services/authService.ts",
          "**/LoginButton/GoogleLoginButton/GoogleLoginButton.tsx",
          "**/OriginWord/kanjiDataFilter.ts",
          "**/pages/LevelSelectionPage/LevelSelectionPage.tsx"
        ],
        "rules": {
          "no-restricted-imports": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@reduxjs/toolkit": "^1.9.5",
    "@types/lodash": "^4.14.195",
    "@vanilla-extract/babel-plugin": "^1.2.0",
    "@vanilla-extract/jest-transform": "^1.1.22",
    "@vanilla-extract/webpack-plugin": "^2.3.27",
    "clsx": "^2.1.0",
    "react-scripts": "5.0.1"
  }
}
