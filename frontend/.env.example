# ===== frontend 환경변수 =====
# 로컬 개발 시 이 파일을 .env 로 복사해 값을 채운다.
# 프로덕션(Vercel 등)에서는 대시보드의 환경변수로 등록한다.
# CRA 규칙: 브라우저에 노출되므로 REACT_APP_ 접두사만 주입되고, 비밀값은 넣지 않는다.

# 개발 서버 포트 (프로덕션 미사용)
PORT=4200

# 백엔드 API 주소
#  - 로컬:  http://localhost:8000
#  - 배포:  https://<backend>.onrender.com
REACT_APP_API_URL=http://localhost:8000

# Google OAuth 클라이언트 ID (공개값)
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=
# 프론트 도메인 기준 콜백 URL
#  예) https://kanji.vercel.app/auth/google/callback
REACT_APP_GOOGLE_REDIRECT_URI=http://localhost:4200/auth/google/callback

# Kakao OAuth (REST 키는 공개 클라이언트용)
REACT_APP_KAKAO_REST_API_KEY=
#  예) https://kanji.vercel.app/auth/kakao/callback
REACT_APP_KAKAO_REDIRECT_URI=http://localhost:4200/auth/kakao/callback
